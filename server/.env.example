# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
# Local MongoDB for development…
MONGODB_URI=mongodb://127.0.0.1:27017/leadflow
# …or MongoDB Atlas in production (no quotes, no line breaks):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/leadflow?retryWrites=true&w=majority

# ---- CORS ----
# Comma separated allow-list of frontend origins. Keep it on ONE line.
# Never use a wildcard in production.
CLIENT_URL=http://localhost:5173,http://localhost:3000
